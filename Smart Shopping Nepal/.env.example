# =====================================================================
# Smart Shopping Nepal - Environment Configuration Template
# Copy this file to .env and adjust variables for your target deployment
# =====================================================================

# Django Core Security
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,smartshoppingnepal.com

# Database Configuration (PostgreSQL in Production / SQLite in Development)
# Option A: Full Connection String (Recommended for Cloud / Container Deployments)
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/smart_shopping_db

# Option B: Individual PostgreSQL Parameters
USE_POSTGRES=False
DB_NAME=smart_shopping_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Production Security Headers
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Streamlit Research Dashboard Port (Default: 8501)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
